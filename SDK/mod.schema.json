{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bladesong:bmf:manifest:1",
  "title": "Bladesong mod.json metadata v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[\\w.-]+)?$"
    },
    "api": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "channel": {
      "enum": [
        "stable",
        "prerelease"
      ]
    },
    "pinned_version": {
      "type": "string"
    },
    "update_provider": {
      "enum": [
        "github",
        "https-manifest"
      ]
    },
    "download": {
      "type": "object",
      "required": [
        "url",
        "sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "optional_dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "pages": {
      "type": "object"
    },
    "settings": {
      "type": "object"
    },
    "icon": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "description": "Reserved; current worker refuses unsupported signatures"
    },
    "files": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "raw_integration": {
      "type": "object",
      "description": "Explicit exception only for integrations outside stable framework services.",
      "required": [
        "reason",
        "game_builds"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "game_builds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      },
      "additionalProperties": false
    },
    "dependency_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "release_source": {
      "type": "object",
      "required": [
        "type",
        "repository"
      ],
      "properties": {
        "type": {
          "const": "github"
        },
        "repository": {
          "type": "string",
          "pattern": "^https://github.com/"
        },
        "tag": {
          "type": "string"
        },
        "manifest_asset": {
          "type": "string"
        },
        "tag_prefix": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtime_components": {
      "type": "object",
      "properties": {
        "UE4SS": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": [
        "format",
        "target"
      ],
      "properties": {
        "format": {
          "const": "bladesong-mod-1"
        },
        "target": {
          "const": "ue4ss-mods"
        }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "standalone": {
      "type": "boolean",
      "description": "Does not require the framework runtime. SDK API is required otherwise."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "standalone": {
            "const": true
          }
        },
        "required": [
          "standalone"
        ]
      },
      "then": {},
      "else": {
        "required": [
          "api"
        ]
      }
    }
  ]
}
